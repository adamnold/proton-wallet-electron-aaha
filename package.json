{
  "name": "proton-wallet-electron-aaha",
  "productName": "proton-wallet-electron-aaha",
  "version": "2.0.0",
  "templateVersion": "3.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/adamnold/proton-wallet-electron-aaha.git"
  },
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "description": "Unofficial Proton Wallet Electron wrapper by Adam And His Agents",
  "main": "src/main.js",
  "author": "Adam And His Agents (AAHA)",
  "license": "Apache-2.0",
  "private": false,
  "scripts": {
    "start": "bash scripts/launch.sh",
    "check": "node scripts/check.js",
    "check:template": "node scripts/check.js --template",
    "test": "node --test",
    "icons": "bash scripts/generate-icons.sh",
    "dist": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "@electron/fuses": "2.1.3"
  },
  "build": {
    "appId": "com.adamandhisagents.proton-wallet-electron-aaha",
    "productName": "proton-wallet-electron-aaha",
    "asar": true,
    "afterPack": "scripts/after-pack.js",
    "appImage": {
      "executableArgs": [
        "--disable-setuid-sandbox"
      ]
    },
    "files": [
      "src/**/*",
      "app.config.js",
      "build/icons/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "dir",
        "AppImage"
      ],
      "category": "Network;Finance",
      "icon": "build/icons",
      "executableName": "proton-wallet-electron-aaha",
      "artifactName": "proton-wallet-electron-aaha-v${version}-${arch}.AppImage",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "proton-wallet-electron-aaha",
          "Comment": "Unofficial Proton Wallet wrapper by Adam And His Agents",
          "Categories": "Network;Finance;",
          "Keywords": "proton;wallet;bitcoin;crypto;",
          "StartupWMClass": "com.adamandhisagents.proton-wallet-electron-aaha",
          "Terminal": false,
          "Type": "Application"
        }
      }
    }
  },
  "desktopName": "com.adamandhisagents.proton-wallet-electron-aaha.desktop"
}
